# =============================================================================
#  Microsoft-Rewards-Script for armv7l / RK3229 — 环境变量模板
#
#  用法：
#     cp deploy/env.rk3229.example /opt/mrs/.env
#     然后填上 ACCOUNT_1_EMAIL / ACCOUNT_1_PASSWORD
#
#  ⚠️ 账号序号规则（最容易静默失败的地方，务必读完）
#     「账号序号」= ACCOUNT_N_EMAIL 里的 N。
#     每个账号的**所有**配置项必须用**同一个 N**：
#         ACCOUNT_1_EMAIL / ACCOUNT_1_PASSWORD
#         ACCOUNT_1_LANG_CODE / ACCOUNT_1_GEO_LOCALE / ACCOUNT_1_SAVE_FINGERPRINT_*
#     如果只写了 ACCOUNT_1_EMAIL，却把调优项写成 ACCOUNT_2_*，
#     那么这些调优项**不会报错，只会静默失效**，账号将以
#     langCode=en / geoLocale=auto / 不保存指纹 运行。
#
#     自检命令：
#       cd /opt/mrs && node -e "console.log(require('./dist/util/Load.js').loadAccounts())"
#     期望输出里 langCode 应为 zh-CN、geoLocale 应为 CN、saveFingerprint 两项为 true。
# =============================================================================

# ---- 账号 1（必填）---------------------------------------------------------
ACCOUNT_1_EMAIL=
ACCOUNT_1_PASSWORD=

# ---- 账号 1 调优项（国内账号强烈建议照抄）----------------------------------
# 前缀必须与上面账号编号一致！
ACCOUNT_1_LANG_CODE=zh-CN
ACCOUNT_1_GEO_LOCALE=CN

# 保存浏览器指纹：弱设备强烈建议开启。开启后同一账号重复运行时
# 复用同一套指纹/会话，显著减少重新登录次数与失败率。
ACCOUNT_1_SAVE_FINGERPRINT_MOBILE=true
ACCOUNT_1_SAVE_FINGERPRINT_DESKTOP=true

# ---- 可选：无密码登录（Authenticator / TOTP / 恢复邮箱）---------------------
# 启用了 2FA 的账号填这里；三条任选其一即可（也可以只填密码）
#ACCOUNT_1_TOTP_SECRET=
#ACCOUNT_1_RECOVERY_EMAIL=

# ---- 可选：账号 2（多账号时取消注释，并把所有项的前缀一起改成 ACCOUNT_2_）----
#ACCOUNT_2_EMAIL=
#ACCOUNT_2_PASSWORD=
#ACCOUNT_2_LANG_CODE=zh-CN
#ACCOUNT_2_GEO_LOCALE=CN
#ACCOUNT_2_SAVE_FINGERPRINT_MOBILE=true
#ACCOUNT_2_SAVE_FINGERPRINT_DESKTOP=true

# ---- 可选：代理 -------------------------------------------------------------
# 走代理时每个账号单独配置（前缀同样跟账号编号）
#ACCOUNT_1_PROXY_HTTP=true
#ACCOUNT_1_PROXY_URL=
#ACCOUNT_1_PROXY_PORT=
#ACCOUNT_1_PROXY_USERNAME=
#ACCOUNT_1_PROXY_PASSWORD=

# ---- 可选：pushplus 推送 ----------------------------------------------------
# ⚠️ 这一行对 MRS **本体的推送无效**！
#    MRS 只读 config.json 的 webhook.pushplus.token，而 .env 里的 CONFIG_* 环境变量
#    **不会自动写回 config.json**（主流程从不加载 src/util/ConfigEnvOverrides.ts）。
#
#    两者分工：
#      start.sh 的 push_msg()  → 直接 grep 这一行后 curl，能推送 ✅
#      MRS 自己跑完的汇总推送  → 读 config.json，不读这里 ❌
#
#    所以想要 MRS 也推送，必须在 config.json 里填：
#      "webhook": { "pushplus": { "enabled": true, "token": "<你的token>", "channel": "" } }
#    注意 channel 是推送渠道(wechat/cp/wx/mail)，不是放 token 的地方。
CONFIG_PUSHPLUS_TOKEN=
